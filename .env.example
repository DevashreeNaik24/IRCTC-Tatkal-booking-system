# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://irctc:irctc_secret@localhost:5432/irctc_tatkal

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Admin ─────────────────────────────────────────────────
# Comma-separated emails allowed to hit /api/admin/* (production only —
# non-production environments bypass this check)
ADMIN_EMAILS=admin@irctc.dev

# ─── Tatkal Window ─────────────────────────────────────────
TATKAL_OPEN_TIME=10:00
TATKAL_CLOSE_TIME=12:00

# ─── Payment ──────────────────────────────────────────────
PAYMENT_HOLD_TTL_SECONDS=120
PAYMENT_CHECKER_INTERVAL_MS=5000

# ─── Admission Control ────────────────────────────────────
ADMISSION_BATCH_SIZE=50
ADMISSION_INTERVAL_MS=5000
ADMISSION_TOKEN_TTL_SECONDS=300
MAX_CONCURRENT_BOOKINGS=200

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_IP=60
RATE_LIMIT_PER_USER_RESERVATION=5
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Back-Pressure ─────────────────────────────────────────
MAX_QUEUE_DEPTH=10000
BACKPRESSURE_THRESHOLD=0.8

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
